void batualizacao(bool avisa){
	speak(pu.get_value("Conectando ao servidor para verificar atualizações..."));
	network nt;
	network_event et;
	timer tt;
	string vser="";
	bool conectou=false;
	nt.setup_client(4, 100);
	nt.connect(serveraddress, serverport);
	tt.restart();
	while(vser==""){
		wait(5);
		if(key_pressed(KEY_ESCAPE))break;
		et=nt.request();
		if(et.type==event_disconnect)break;
		if(et.type==event_connect){
			conectou=true;
			nt.send_reliable(et.peer_id, "pedirversao", 0);
		}
		if(et.type==event_receive){
			string[] pv=string_split(receber(et.message), " ", false);
			if(pv[0]=="versaoatual"&&pv.length()>1)vser=pv[1];
		}
		if(tt.elapsed>=5000)break;
	}
	if(vser==""){
		if(conectou){
			dlg(pu.get_value("O servidor não respondeu à verificação. O servidor precisa ser recompilado com a versão nova para essa função funcionar."));
		}
		else{
			dlg(pu.get_value("Não foi possível conectar ao servidor para verificações."));
		}
		menuprincipal();
	}
	else if(vser==ver){
		dlg(pu.get_value("Nenhuma atualização até o momento."));
		menuprincipal();
	}
	else{
		vernova=vser;
		updatefound.play_wait();
		dlg(pu.get_value("Foi encontrada uma nova versão do jogo. A sua versão é")+" "+ver+". "+pu.get_value("A nova versão é")+" "+vernova+".");
		updatemenu();
	}
}

void atualizarv(){
	speak(pu.get_value("Iniciando o processo de atualização..."));
	sound updating;
	updating.stream("update_starting.ogg");
	updating.play_wait();
	file fo;
	if(!fo.open(INSTALLER_NAME,"wb")){
		dlg(pu.get_value("Não foi possível criar o arquivo do instalador."));
		menuprincipal();
		return;
	}
	network nt;
	network_event et;
	timer tt;
	double off=0;
	double tam=0;
	double percent=-1;
	bool erro=false;
	bool fim=false;
	nt.setup_client(4, 100);
	nt.connect(serveraddress, serverport);
	tt.restart();
	while(!fim&&!erro){
		wait(5);
		if(key_pressed(KEY_ESCAPE)){
			erro=true;
		}
		et=nt.request();
		if(et.type==event_connect){
			nt.send_reliable(et.peer_id, "instreq "+off, 0);
		}
		else if(et.type==event_disconnect){
			erro=true;
		}
		else if(et.type==event_receive){
			string msg=receber(et.message);
			string[] pv=string_split(msg, " ", false);
			if(pv[0]=="insdata"&&pv.length()>4){
				tam=string_to_number(pv[2]);
				string bruto=string_base64_decode(string_replace(msg, "insdata "+pv[1]+" "+pv[2]+" ", "", false));
				fo.write(bruto);
				off=off+bruto.length();
				if(tam>0){
					double p=round(off/tam*100,0);
					if(p!=percent){
						percent=p;
						beep_percentage(percent);
					}
				}
				nt.send_reliable(et.peer_id, "instreq "+off, 0);
			}
			else if(pv[0]=="insfim"){
				fim=true;
			}
			else if(pv[0]=="inserr"){
				erro=true;
			}
		}
		if(tt.elapsed>=DOWNLOAD_TIMEOUT)erro=true;
	}
	fo.close();
	if(erro){
		file_delete(INSTALLER_NAME);
		dlg(pu.get_value("Falha ao baixar o instalador. O servidor precisa ter o arquivo")+" "+INSTALLER_NAME+" "+pu.get_value("na mesma pasta."));
		menuprincipal();
		return;
	}
	updatemus.stop();
	updatedone.play_wait();
	speak(nomejogo+" "+vernova+" "+pu.get_value("Acabou de ser baixado!"));
	wait(1000);
	run(INSTALLER_NAME, "", false, false);
	exit();
}
